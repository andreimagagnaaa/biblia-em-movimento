{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v/:arquivo", "destination": "https://github.com/andreimagagnaaa/biblia-em-movimento/releases/download/videos/:arquivo" }
  ],
  "headers": [
    { "source": "/v/(.*)", "headers": [{ "key": "Content-Type", "value": "video/mp4" }, { "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
